{
  "author": "SASU JAK MOOH",
  "cloudEndpoint": "https://nlocale.fr/mcp",
  "description": "Read-only MCP server for the NLocale guide to Aisne, France: sourced events, places, restaurants, stays and local authorities, in six languages.",
  "homepage": "https://nlocale.fr",
  "icon": "https://nlocale.fr/logo.svg",
  "identifier": "nlocale",
  "name": "NLocale",
  "prompts": [],
  "resources": [],
  "tags": [
    "travel",
    "tourism",
    "events",
    "local-guide",
    "aisne",
    "france",
    "multilingual",
    "read-only"
  ],
  "tools": [
    {
      "name": "rechercher_etablissements",
      "title": "Rechercher des établissements",
      "description": "Recherche dans les fiches publiques NLocale. Les dates de vérification et le statut décrivent les contrôles réellement effectués.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 160
          },
          "categorie": {
            "type": "string",
            "maxLength": 120
          },
          "commune": {
            "type": "string",
            "maxLength": 120
          },
          "langue": {
            "default": "fr",
            "type": "string",
            "enum": [
              "fr",
              "en",
              "de",
              "nl",
              "it",
              "es"
            ]
          },
          "limit": {
            "default": 10,
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "title": "Rechercher des établissements",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "rechercher_evenements",
      "title": "Rechercher des événements",
      "description": "Événements publiés et actifs de l’agenda NLocale, avec leurs occurrences. Les tarifs renseignés ne constituent pas un devis.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 160
          },
          "categorie": {
            "type": "string",
            "maxLength": 120
          },
          "commune": {
            "type": "string",
            "maxLength": 120
          },
          "langue": {
            "default": "fr",
            "type": "string",
            "enum": [
              "fr",
              "en",
              "de",
              "nl",
              "it",
              "es"
            ]
          },
          "limit": {
            "default": 10,
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "date_debut": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "date_fin": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "periode": {
            "default": "a_venir",
            "type": "string",
            "enum": [
              "a_venir",
              "archives",
              "tous"
            ]
          },
          "gratuit": {
            "type": "boolean"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "title": "Rechercher des événements",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "chercher_sorties",
      "title": "Chercher des sorties sourcées",
      "description": "Alias stable de rechercher_evenements : commune, dates, catégorie, gratuité explicitement connue et langue. Les résultats comprennent les références des fiches publiques et leurs sources.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 160
          },
          "categorie": {
            "type": "string",
            "maxLength": 120
          },
          "commune": {
            "type": "string",
            "maxLength": 120
          },
          "langue": {
            "default": "fr",
            "type": "string",
            "enum": [
              "fr",
              "en",
              "de",
              "nl",
              "it",
              "es"
            ]
          },
          "limit": {
            "default": 10,
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "date_debut": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "date_fin": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "periode": {
            "default": "a_venir",
            "type": "string",
            "enum": [
              "a_venir",
              "archives",
              "tous"
            ]
          },
          "gratuit": {
            "type": "boolean"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "title": "Chercher des sorties sourcées",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "agenda_weekend",
      "title": "Préparer le week-end dans l’Aisne",
      "description": "Sélection de rendez-vous publiés du vendredi au dimanche, calculée à la date actuelle de Paris. Secteur : Laon, Saint-Quentin, Soissons, Château-Thierry, Chauny, Hirson ou Villers-Cotterêts. Ne contient aucune promesse de maintien ni réservation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "secteur": {
            "type": "string",
            "maxLength": 120
          },
          "langue": {
            "default": "fr",
            "type": "string",
            "enum": [
              "fr",
              "en",
              "de",
              "nl",
              "it",
              "es"
            ]
          },
          "limit": {
            "default": 5,
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "title": "Préparer le week-end dans l’Aisne",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "rechercher_collectivites",
      "title": "Rechercher des collectivités",
      "description": "Informations institutionnelles approuvées et publiées. Français, anglais, allemand, néerlandais, italien ou espagnol ; la langue réellement disponible est indiquée. Aucune statistique, donnée d’inscription ou information privée.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 160
          },
          "insee_code": {
            "type": "string",
            "pattern": "^[0-9A-Z]{5}$"
          },
          "langue": {
            "default": "fr",
            "type": "string",
            "enum": [
              "fr",
              "en",
              "de",
              "nl",
              "it",
              "es"
            ]
          },
          "limit": {
            "default": 10,
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "title": "Rechercher des collectivités",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "rechercher_contenus_publics",
      "title": "Rechercher guides, FAQ, méthode et offres NLocale",
      "description": "Contenus réellement publiés dans la langue demandée : FAQ, sources, méthode, offres et conditions publiques. Chaque résultat comprend une référence vers le détail public et son lien.",
      "inputSchema": {
        "type": "object",
        "properties": {
