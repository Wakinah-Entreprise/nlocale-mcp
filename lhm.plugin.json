            "maximum": 20
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "title": "Rechercher guides, FAQ, méthode et offres NLocale",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "rechercher_lieux",
      "title": "Rechercher des lieux documentés",
      "description": "Patrimoine et lieux dont les faits publics sont documentés. Une vérification documentaire ne constitue pas une visite.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 160
          },
          "categorie": {
            "type": "string",
            "maxLength": 120
          },
          "commune": {
            "type": "string",
