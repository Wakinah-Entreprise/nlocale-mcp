    {
      "name": "lire_fiche_publique",
      "title": "Lire une fiche publique et ses sources",
      "description": "Détails factuels de la clé retournée par une recherche, après vérification de la publication actuelle. La réponse comprend le lien NLocale et les sources originales, avec des champs distincts pour la récupération, la validation documentaire, l’identité et la visite.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 250,
            "pattern": "^(event|business|municipality|place|content):[a-zA-Z0-9-]+$"
          },
          "langue": {
            "default": "fr",
            "type": "string",
            "enum": [
              "fr",
              "en",
              "de",
              "nl",
              "it",
              "es"
            ]
          }
        },
        "required": [
          "key"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "title": "Lire une fiche publique et ses sources",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "rechercher_articles_carnet",
      "title": "Rechercher les articles publiés du Carnet",
      "description": "Rencontres, coulisses et récits publiés par NLocale dans la langue demandée, avec auteur réel, sources et dates. Français, anglais, allemand, néerlandais, italien et espagnol. Aucun brouillon ni remplacement par une autre langue. Les slugs retournés donnent accès aux articles détaillés.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 160
          },
          "langue": {
            "default": "fr",
            "type": "string",
            "enum": [
              "fr",
              "en",
              "de",
              "nl",
              "it",
              "es"
            ]
          },
          "limit": {
            "default": 10,
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "offset": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "title": "Rechercher les articles publiés du Carnet",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "lire_article_carnet",
      "title": "Lire un article publié du Carnet",
      "description": "Version actuellement publique de l’article dans la langue demandée, avec auteur, sources, statut de visite et éventuel partenariat. La réponse comprend le lien NLocale localisé et la signature publiée, distincte de l’identité des personnes interviewées.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "maxLength": 180,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "langue": {
            "default": "fr",
            "type": "string",
            "enum": [
              "fr",
              "en",
              "de",
              "nl",
              "it",
              "es"
            ]
          }
        },
        "required": [
          "slug"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "title": "Lire un article publié du Carnet",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    }
